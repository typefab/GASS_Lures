# ----------------------------------------------------------------------------
# GASS Lures — variabili d'ambiente
# Copia questo file in `.env.local` e compila i valori.
# ----------------------------------------------------------------------------

# URL pubblico del sito (senza slash finale). In locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database -----------------------------------------------------------------
# In locale usa un file SQLite. In produzione usa Turso (piano gratuito):
#   DATABASE_URL="libsql://nome-db-utente.turso.io"
#   DATABASE_AUTH_TOKEN="ey..."
DATABASE_URL="file:./data/gass.db"
DATABASE_AUTH_TOKEN=""

# --- Pannello di amministrazione ----------------------------------------------
# Password per accedere a /admin. OBBLIGATORIA in produzione.
ADMIN_PASSWORD="cambiami"
# Segreto usato per firmare il cookie di sessione admin (stringa lunga e casuale).
AUTH_SECRET="genera-con: openssl rand -base64 32"

# --- Pagamenti (Stripe) -------------------------------------------------------
# Se queste variabili sono vuote il sito funziona in MODALITÀ DIMOSTRATIVA:
# il checkout viene simulato e gli ordini vengono registrati come "demo".
# Chiavi di TEST: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (opzionale) --------------------------------------------------------
# Se vuoto, le email vengono solo scritte nei log del server.
RESEND_API_KEY=""
EMAIL_FROM="GASS Lures <info@gasslures.com>"
